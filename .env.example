# Admin session — REQUIRED in production
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Persistence backend
# json = local/demo data/store.json
# prisma = PostgreSQL through Prisma
A2_STORE_BACKEND=json
A2_DATA_FILE=./data/store.json
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/a2_store?schema=public

# Media storage
# local stores files under public/uploads/ (development only)
# s3 supports AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO and other S3-compatible services.
MEDIA_STORAGE=local
MEDIA_PREFIX=products
MEDIA_MAX_FILE_MB=15

# Required when MEDIA_STORAGE=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public CDN/bucket origin, e.g. https://cdn.example.com
MEDIA_PUBLIC_URL=
